LLAMACPP_SERVERS=coder=http://localhost:8080,oracle=http://localhost:8080,vision=http://localhost:8082,embed=http://localhost:8083
LLAMACPP_HOST=http://localhost:8080
COMPASS_FAMILY=llamacpp

VISION_MODEL=llamacpp@vision
COMPASS_MAX_TOKENS=2000

# Optional computer-use backends.
# If unset, Compass will use NEO_OCR_SERVER / NEO_DINO_SERVER when present,
# then fall back to the host from LLAMACPP_SERVERS embed=..., then localhost.
# OCR_URL=http://localhost:9003/ocr
# DETECT_URL=http://localhost:9004/detect

# Driver: Who approves plans and actions
# Options: auto (default), user (you approve), claude (I approve)
# COMPASS_DRIVER=auto
COMPASS_DRIVER=auto

# For user driver: approve each action (1) or just plans (0)
COMPASS_APPROVE_ACTIONS=1

# For claude driver: strict mode reviews ALL actions, not just risky ones
# COMPASS_CLAUDE_STRICT=0

# /ask command configuration
# ASK_PROVIDER: who answers the question
#   oracle - local LLM responds directly (default if no ANTHROPIC_API_KEY)
#   claude - Claude responds, then can drive Oracle execution if approved
# ASK_PROVIDER=oracle
ASK_PROVIDER=neo

# ASK_FORMAT: how to display Oracle's response (only for ASK_PROVIDER=oracle)
#   raw - authentic response, streamed as-is (default)
#   formatted - pipe through Answerer for structured {answer, references, next_steps}
ASK_FORMAT=raw
# ASK_FORMAT=formatted

DEBUG_PROMPTS=all

# === STREAM VISUALIZATION ===
# Enable JSONL stream logging for NFA visualization
# Logs go to ~/.compass/code/{session_id}/streams/
COMPASS_STREAM_LOG=1

COMPASS_COMPACTION_ENABLED=1
COMPASS_COMPACTION_METRICS=1
COMPASS_CTX_MAX_CHARS=500000
COMPASS_CTX_THRESHOLD=0.90
COMPASS_OUTER_MAX_CHARS=600000
COMPASS_OUTER_RETENTION=0.75
COMPASS_OUTER_THRESHOLD=0.90
